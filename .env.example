# Copiar a .env.local. El .env.local NO se commitea.

# Proyecto de Sanity "Gala Arq", en la organizacion Gala Arq (ozejyyn9m)
NEXT_PUBLIC_SANITY_PROJECT_ID=3ibcmrqh

# development mientras construimos. production queda vacio hasta la fase 3 (spec §6.5)
NEXT_PUBLIC_SANITY_DATASET=development

# Fecha fija de la API. Subirla es un cambio deliberado.
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-19

# Secreto compartido con el webhook de Sanity (paso 3.1).
# Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NUNCA commitear el valor real: va en .env.local y en los secrets del Worker.
SANITY_REVALIDATE_SECRET=
