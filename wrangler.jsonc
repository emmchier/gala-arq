{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",

  // Entorno de desarrollo (spec §6.5). El de produccion se agrega en la fase 3
  // como "env.production", con su propio nombre y dominio.
  "name": "gala-arq-dev",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Sin este binding el Worker responde 500 en workers.dev (spec §13.2).
  // El "service" tiene que coincidir exactamente con "name".
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gala-arq-dev"
    }
  ],

  // Cache incremental de ISR en KV. R2 exige habilitarlo en el dashboard y
  // pide medio de pago; KV viene con el plan free (spec §6.4).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "79874aeeede64b1a833245f9cb5bd42b"
    }
  ],

  // Optimizacion de imagenes de Cloudflare.
  "images": {
    "binding": "IMAGES"
  }
}
